# =============================================================================
# OpenList-TSWorker · 環境變量（模板）
# =============================================================================
#
# 用途：Cloudflare「Deploy to Cloudflare」按鈕會讀取本文件（或 .dev.vars.example）
#       識別需要用戶填寫的變量，並在部署頁生成對應輸入項。
#
# 為什麼值留空：本文件會提交到公開倉庫，絕不能包含真實密鑰。
#   部署時用戶填入的值會成為該 Worker 的 Secret，後續更新不會被覆蓋。
#
# 本地開發：複製為 `.env`（已被 .gitignore 忽略）並填入真實值。
#
# 完整變量說明見：
#   https://doc.oplist.org/ecosystem/official_worker/guide_env
# =============================================================================

# ── 必填 ────────────────────────────────────────────────────────────────────

# JWT 簽名密鑰，同時用作可選的欄位加密密鑰（DB_CIPHER 非 none 時，見 wrangler.jsonc）
# 與定時任務鑑權。要求 >=16 字符；推薦用 `openssl rand -hex 32` 生成。
JWT_SECRET=

# ── 選填 ────────────────────────────────────────────────────────────────────

# 跳過安裝嚮導，直接用此密碼初始化 admin 賬號。留空則由瀏覽器嚮導設置。
ADMIN_PASS=

# CORS 允許來源白名單，逗號分隔，如 https://yourdomain.com
# 留空表示僅允許同源請求。
ALLOW_URLS=

# 前端靜態資源 CDN 地址（可選）。需指向包含完整前端 dist 的目錄（含 index.html）。
# 配置後瀏覽器直連 CDN 加載 JS/CSS/圖片等資源，不再經 Worker 中轉。
# 注入自動在兩條路徑中選擇：
#   A. CDN 上存在本地構建引用的哈希資產 → 直接下發本地 index.html 並注入 cdn
#      （不要求 CDN 能返回 HTML —— npmmirror 等禁止訪問 .html 的 CDN 靠這條工作，
#       等價 Go Release 版行為）
#   B. 否則改用 CDN 自己的 index.html，保證 HTML 與哈希資產同源一致
#   A、B 都不可用 → 不注入，資源回退源站加載（不會白屏）
#   A 要求 CDN 上的產物與本次部署的 dist 是同一份構建（哈希逐字節相同）。默認
#   `pnpm run build` 會從 npm 拉取【已發佈】的前端 dist（scripts/fetch-frontend.mjs），
#   與 CDN 內容天然同源，故 A 會命中 —— npmmirror 這類禁止訪問 .html 的 CDN 只能
#   靠 A 工作；若用 FRONTEND_BUILD_FROM_SOURCE=1 從 main 現構建，哈希與 CDN 不一致，
#   A 必然落空（只能退化到 B，而 B 對 npmmirror 不可用）。
# 支持 $version 佔位符，替換為本構建的前端版本號（構建期寫入，解析失敗回退 latest）。
# 注意：注入只發生在「HTML 入口請求能到達 Worker」時。若平台默認用靜態層直出
# /index.html（如 Cloudflare 的資源優先路由、EdgeOne middleware rewrite），
# 需讓 / 與 /index.html 走 Worker（CF 見 wrangler.jsonc 的 run_worker_first）。
#
# ⚠️ 資源由瀏覽器直接加載，CDN 必須對 .js/.css/字體返回 Access-Control-Allow-Origin
#    （前端產物以 crossorigin 加載 module script / stylesheet）。
#    jsdelivr、unpkg 固定返回 *；npmmirror 在請求帶 Origin 時回顯該頭，同樣可用。
#
# ⚠️ 行為變更（遷移說明）：舊實現是 assetsRouter 的 /:folder/:filepath* 路由，把
#    每個靜態資源請求都 302 重定向到 CDN。該路由已移除 —— 它取不到 filepath，
#    且在靜態層優先的平台上根本不會進 Worker；現在統一改為上面的 HTML 注入，
#    由瀏覽器直連 CDN。未配置 ASSET_URLS 時靜態資源一律由源站提供。
#    另：/assets、/images、/streamer、/static 下的文件若在源站確實缺失，仍會 302
#    到 CDN（對齊 Go 版 static.go 的 folders），避免 SPA 兜底把 index.html 當作
#    .js/.css 返回。
# 例：
#   https://registry.npmmirror.com/@openlist-frontend/openlist-frontend/$version/files/dist
#   https://cdn.jsdelivr.net/npm/@openlist-frontend/openlist-frontend@$version/dist
#   https://unpkg.com/@openlist-frontend/openlist-frontend@$version/dist
ASSET_URLS=

# MySQL 連接串（DB_DRIVER=mysql 時必填），如 mysql://user:pass@host:3306/db
# 也可改用 wrangler.jsonc 中註釋的 MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASS / MYSQL_NAME 分項。
MYSQL_URLS=

# EdgeOne Node 雲函數專用：KV 代理地址（DB_DRIVER=kv 且運行在 EdgeOne Node 雲函數時必填）。
# EdgeOne 的 KV 綁定不會注入 Node 雲函數，必須經同部署的 Edge Functions 代理訪問，
# 此處填寫部署的 origin，如 https://your-project.edgeone.app
# 留空時自動使用當前請求的 origin（同一部署自調用）；跨域或本地調試才需顯式設置。
EO_KV_URLS=

# Cloudflare KV REST API 憑據（DB_DRIVER=cfkv 時三項均必填）。
# 賬戶 ID
CF_ACCOUNT=
# KV namespace ID
CF_KV_UUID=
# 具有 KV 讀寫權限的 API Token
CF_API_KEY=
