// =============================================================================
// OpenList-TSWorker · Cloudflare Workers 配置
// 文件：https://developers.cloudflare.com/workers/wrangler/configuration/
//
// ⚠️ 本文件僅聲明 KV 一個儲存綁定（見文件末 kv_namespaces），D1 / DO 等
//    其它儲存請按需在控制檯添加。
//
// 為什麼聲明 KV 且【省略 id 欄位】（不能寫 "id": ""）：
//   wrangler 會自動預配（automatic provisioning）：首次部署創建
//   "項目名-綁定名" 的命名空間（此處即 openlist-tsworkers-kv）並綁定；
//   二次部署通過服務端 inherit 複用已有綁定，不會重複創建。
//
// 注意：CI / 一鍵部署屬非交互環境，wrangler 不會把生成的 id 回寫進本文件。
// 這是預期行為 —— 複用靠的是服務端 inherit 綁定，而非本地 id。
//
// ⚠️ 不要用 `wrangler kv namespace create` 手動建名為 "KV" 的命名空間：
//   wrangler 的預配鏈路無法按 title 複用已有命名空間（KVHandler 未實現
//   isConnectedToExistingResource），它會另建 openlist-tsworkers-kv，
//   手動建的那個不會被任何綁定使用，成為孤兒資源。參見 Issue #34。
//
// Secret（JWT_SECRET / ADMIN_PASS / ALLOW_URLS / MYSQL_URLS / EO_KV_URLS / CF_* 等）請在
// .dev.vars.example 或 .env.example 中聲明 —— 部署按鈕據此生成輸入項，
// 用戶填入的值會成為該 Worker 的 Secret，後續更新不會被覆蓋。
// =============================================================================
{
  "name": "openlist-workers",
  "main": "src/backend/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,

  // "custom_domains": [
  //   "cloud.itools.dpdns.org"
  // ],

  // ⚠️ run_worker_first 僅放行 HTML 入口，不能改成 true（全量放行）：
  //   默認「資源優先」時 / 與 /index.html 由靜態層直接返回，Worker 根本不會執行，
  //   ASSET_URLS 的 CDN 注入（fetch CDN index.html → 注入 window.OPENLIST_CONFIG.cdn）
  //   永遠不生效，前端仍從源站加載全部靜態資源。
  //   僅放行 HTML 入口後，帶 hash 的 JS/CSS/圖片仍由靜態層直出、零 Worker 調用，
  //   僅有頁面導航請求才多付一次 Worker 調用。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },

  // ===========================================================================
  // 普通環境變量（非敏感）
  // 注意：vars 會在每次 wrangler deploy 時被本文件覆蓋（Secrets 不會）。
  // ===========================================================================
  "vars": {
    "ENVIRONMENT": "production",

    // 資料儲存格式：
    //   map（默認）- 整對象序列化為單個 JSON 鍵值，適合 KV/Blob
    //   key        - 分 key 儲存，每實體一條記錄（如 users_1）
    //   sql        - 關係表格式，與 Go 後端一致（適用於 D1/MySQL）
    "DB_FORMAT": "sql",

    // 資料庫驅動：
    //   auto（默認）- 自動檢測，順序 mysql → d1 → kv → cfkv → blob → do
    //   blob       - 騰訊雲 EdgeOne Blob / 阿里雲 ESA Blob
    //   cfkv       - Cloudflare KV REST API（需 CF_ACCOUNT / CF_KV_UUID / CF_API_KEY）
    //   kv         - Cloudflare KV binding（需下方 kv_namespaces）
    //   d1         - Cloudflare D1（需下方 d1_databases）
    //   do         - Cloudflare Durable Objects（需下方 durable_objects）
    //   mysql      - 外部 MySQL（需 MYSQL_URLS 或 MYSQL_HOST 等，僅 Node 運行時）
    // 說明：mysql 僅在配置了連接信息時才參與 auto 探測，避免無謂的 TCP 建連。
    "DB_DRIVER": "d1",

    // 敏感欄位落盤算法（默認 none：不加密；與 DB_DRIVER/DB_FORMAT 正交）：
    //   none（默認）              - 不加密，敏感欄位明文落盤
    //   aes-256-gcm              - HKDF 派生 AES-256-GCM 密鑰（enc:v2:，推薦）
    //   aes-256-gcm-pbkdf2       - AES-256-GCM + PBKDF2-SHA256(10 萬次) 逐欄位派生
    //                              （歷史 enc:v1: envelope，每欄位約 27ms，慢）
    //   aes-256-cbc-hmac         - AES-256-CBC + HMAC-SHA256（enc:v3:）
    //   chacha20-poly1305        - ChaCha20-Poly1305（enc:v4:，RFC 8439，純 JS）
    //   des-cbc-hmac             - 單 DES + HMAC-SHA256（enc:v5:，僅相容，不安全）
    //   3des-cbc-hmac            - 3DES + HMAC-SHA256（enc:v6:，僅相容，已棄用）
    // 說明：加密對象為 storages[].addition / 敏感 settings / users[].password /
    //       users[].otp_secret。密文帶 enc:vN: 前綴，讀取時按前綴自動解密，
    //       因此把該項改回 none 不會導致既有資料不可讀（下次保存自動轉為明文）。
    // 注意：該項與 JWT 密鑰無關 —— DB_CIPHER=none 時，未配置 JWT_SECRET 仍會
    //       自動生成並持久化共享密鑰（JWT 簽名需要）。
    "DB_CIPHER": "none",

    // ── 安全鑑權（推薦以 Secret 類型配置，見 .dev.vars.example）──────────
    //
    // JWT 簽名密鑰（>=16 字符，兼作可選的欄位加密密鑰與定時任務鑑權）
    // "JWT_SECRET": "",  // ⚠️ 請通過 wrangler secret put JWT_SECRET 設置
    //
    // 跳過安裝嚮導，自動以該密碼初始化 admin
    // "ADMIN_PASS": "",  // ⚠️ 請通過 wrangler secret put ADMIN_PASS 設置
    //
    // CORS 白名單（逗號分隔，不設則僅同源）
    // "ALLOW_URLS": "https://yourdomain.com",

    // ── 可選參數 ──────────────────────────────────────────────────────────
    //
    // 單次整體上傳（/put、/form）大小上限，單位字節。默認 26214400（25MB）
    // "MAX_UPLOAD": "26214400",
    //
    // 分片上傳單片大小上限，單位字節。默認 16777216（16MB）
    // "MAX_UPPART": "16777216",
    //
    // 前端靜態資源 CDN 地址，需包含完整 dist（含 index.html），支持 $version 佔位符
    // 優先「本地 index.html + CDN 資產」（不要求 CDN 能返回 HTML，npmmirror 也能用）；
    // 本地哈希不在 CDN 上時改用 CDN 的 index.html 保證同源；都不可用則回退源站
    // ⚠️ 資源由瀏覽器直接加載，CDN 必須對 .js/.css 返回 Access-Control-Allow-Origin
    // "ASSET_URLS": "https://registry.npmmirror.com/@openlist-frontend/openlist-frontend/$version/files/dist",
    // "ASSET_URLS": "https://cdn.jsdelivr.net/npm/@openlist-frontend/openlist-frontend@$version/dist",
    // "ASSET_URLS": "https://unpkg.com/@openlist-frontend/openlist-frontend@$version/dist",
    //
    // 允許作為種子資料來源的主機白名單，逗號/空格分隔
    // "ALLOW_SEED": "",

    // ── Cloudflare KV REST API（DB_DRIVER=cfkv 時三項需全部填寫）───────────
    //
    // KV namespace ID
    // "CF_KV_UUID": "",
    //
    // 賬戶 ID
    // "CF_ACCOUNT": "",
    //
    // 具有 KV 讀寫權限的 API Token
    // "CF_API_KEY": "",

    // ── EdgeOne Node 雲函數 KV 代理（DB_DRIVER=kv 時可選）──────────────────
    //
    // EdgeOne 的 KV 綁定僅注入 Edge Functions，不會注入 Node 雲函數。
    // 運行在 EdgeOne Node 雲函數時，必須經同部署的 Edge Functions 代理訪問 KV。
    // 此處填部署 origin，如 https://your-project.edgeone.app
    // 留空則自動使用當前請求 origin（同一部署自調用）；跨域或本地調試才需顯式設置。
    // "EO_KV_URLS": "",

    // ── MySQL（DB_DRIVER=mysql 時，方式一 / 方式二 二選一）─────────────────
    //
    // 方式一：連接串
    // "MYSQL_URLS": "mysql://user:pass@host:3306/db",
    //
    // 方式二：分項配置
    // "MYSQL_HOST": "127.0.0.1",
    // "MYSQL_PORT": "3306",
    // "MYSQL_USER": "root",
    // "MYSQL_PASS": "",
    // "MYSQL_NAME": "openlist",
  },

  // ===========================================================================
  // 儲存綁定
  // ===========================================================================
  //
  // ▶ 方案 A：KV（默認啟用，免費額度大、最通用）
  //   ⚠️ 必須【完全省略 id 欄位】，不能寫成 "id": ""：
  //      wrangler 配置校驗會拒絕空字符串 id（"should have a string id field"）。
  //   省略 id 後：首次部署由 wrangler 自動創建 openlist-tsworkers-kv 並綁定；
  //   二次部署通過 inherit 複用已有綁定，不會重複創建。
  //   若想改用賬戶裡已有的 KV，把該命名空間的 id 填進來即可。
  //
  //  "kv_namespaces": [{ "binding": "KV" }],
  //
  // ▶ 方案 B：D1（關係型，可與 Go 後端共享庫；DB_FORMAT 建議改為 "sql"）
  //   控制檯：Workers & Pages → D1 → 創建資料庫 → 綁定到 Worker，變量名填 DB
  //   省略 database_id 時，wrangler >= 4.45.0 會自動創建同名庫並回寫
  //
  "d1_databases": [
    { "binding": "DB", "database_name": "openlist-db" }
  ]
  //
  // ▶ 方案 C：Durable Objects（內置 SQLite，強一致；DB_FORMAT 建議改為 "sql"）
  //   注意：DO 需要 migrations，且刪除成本高，適合單租戶部署。
  //
  // "durable_objects": {
  //   "bindings": [{ "name": "DO", "class_name": "OpenListDB" }]
  // },
  // "migrations": [
  //   { "tag": "v1", "new_sqlite_classes": ["OpenListDB"] },
  // ],
  //
  // ▶ 方案 D：Blob / MySQL
  //   Blob 由 EdgeOne / ESA 自動注入，無需配置；
  //   MySQL 通過 Secret 配置 MYSQL_URLS（或 MYSQL_HOST 等分項）。
}
